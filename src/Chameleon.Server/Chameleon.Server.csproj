<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
        <TieredCompilation>true</TieredCompilation>
        <!-- PGO: JIT доводит горячие пути (сессия, TLS, relay) по реальному профилю. -->
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>        
        <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="100663296" Trim="false" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Chameleon.Core\Chameleon.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Dapper" Version="2.1.89" />
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    </ItemGroup>

</Project>
