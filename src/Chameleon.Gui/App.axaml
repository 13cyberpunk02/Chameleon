<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Chameleon.Gui.App"
             xmlns:vms="using:Chameleon.Gui.ViewModels"
             xmlns:views="using:Chameleon.Gui.Views"
             xmlns:local="using:Chameleon.Gui"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="ChameleonGreen">#3FB950</Color>
            <Color x:Key="ChameleonGreenDark">#2EA043</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ChameleonGreen}" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Button.nav">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#22808080" />
        </Style>
        <Style Selector="Button.nav.active">
            <Setter Property="Background" Value="#333FB950" />
        </Style>
    </Application.Styles>

    <Application.DataTemplates>
        <DataTemplate DataType="vms:ConnectViewModel">
            <views:ConnectView />
        </DataTemplate>
        <DataTemplate DataType="vms:ServersViewModel">
            <views:ServersView />
        </DataTemplate>
        <DataTemplate DataType="vms:LogsViewModel">
            <views:LogsView />
        </DataTemplate>
        <DataTemplate DataType="vms:SettingsViewModel">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="vms:RoutingViewModel">
            <views:RoutingView />
        </DataTemplate>
    </Application.DataTemplates>
</Application>