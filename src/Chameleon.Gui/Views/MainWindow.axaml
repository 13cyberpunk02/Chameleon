<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Chameleon.Gui.ViewModels"
        x:Class="Chameleon.Gui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="900" Height="600" MinWidth="720" MinHeight="480"
        Title="Chameleon" WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="220,*">

        <Border Grid.Column="0" Background="#0C000000">
            <DockPanel Margin="0,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="18,4,0,16" Spacing="10">
                    <Svg Path="/Assets/chameleon-shield.svg" Width="26" Height="26" VerticalAlignment="Center"/>
                   
                    <TextBlock Text="Chameleon" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Pages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PageViewModel">
                            <Button Classes="nav" Classes.active="{Binding IsActive}"
                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).NavigateCommand}"
                                    CommandParameter="{Binding}">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <TextBlock Text="{Binding Icon}" FontSize="16" Width="22" TextAlignment="Center" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <ContentControl Grid.Column="1" Margin="24" Content="{Binding Current}" />
    </Grid>
</Window>