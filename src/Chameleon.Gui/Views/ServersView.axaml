<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chameleon.Gui.ViewModels"
             x:Class="Chameleon.Gui.Views.ServersView"
             xmlns:proxy="using:Chameleon.Gui"
             x:DataType="vm:ServersViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="h1" Text="Серверы" Margin="0,0,0,4" />
        <TextBlock DockPanel.Dock="Top" Classes="subtitle" Text="Выбранный профиль используется для подключения"
                   Margin="0,0,0,14" />

        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="0,0,0,12">
            <Button Classes="accent" Command="{Binding AddFromLinkCommand}"
                    ToolTip.Tip="Взять chameleon://... из буфера обмена">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="btn" Data="{StaticResource IconPlus}" />
                    <TextBlock Text="Добавить из ссылки" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Command="{Binding CopyLinkCommand}">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="btn" Data="{StaticResource IconLink}" />
                    <TextBlock Text="Скопировать ссылку" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Button Classes="danger" Command="{Binding RemoveCommand}">
                <StackPanel Orientation="Horizontal">
                    <PathIcon Classes="btn" Data="{StaticResource IconTrash}" />
                    <TextBlock Text="{Binding RemoveText}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Classes="subtitle" Text="{Binding Hint}" Margin="0,10,0,0" />

        <Border Classes="card" Padding="4">
            <Panel>
            <TextBlock Classes="subtitle" IsVisible="{Binding IsEmpty}" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380"
                       Text="Серверов пока нет. Скопируйте ссылку chameleon://… от администратора сервера и нажмите «Добавить из ссылки»." />
            <ListBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding Selected, Mode=TwoWay}"
                     Background="Transparent">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="proxy:ServerProfile">
                        <Grid ColumnDefinitions="*,Auto" Margin="6,8">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding Display}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Server}" Classes="label" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Sni}" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </Panel>
        </Border>
    </DockPanel>
</UserControl>