<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chameleon.Gui.ViewModels"
             x:Class="Chameleon.Gui.Views.ConnectView"
             x:DataType="vm:ConnectViewModel">
    <StackPanel Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">

        <TextBlock Text="{Binding ActiveProfile}" HorizontalAlignment="Center"
                   Classes="subtitle" FontSize="14" />

        <Button Command="{Binding ToggleCommand}"
                Width="180" Height="180" CornerRadius="90"
                HorizontalAlignment="Center"
                Background="{DynamicResource PowerButtonBrush}" BorderBrush="{Binding StatusColor}"
                BorderThickness="4" Cursor="Hand">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                <!-- Векторный значок: символ ⏻ в шрифтах Windows 10 отсутствует и рисовался «квадратиками» -->
                <PathIcon Data="{Binding PowerIcon}" Width="54" Height="54" HorizontalAlignment="Center"
                          Foreground="{Binding StatusColor}" />
                <TextBlock Text="{Binding ButtonText}" FontSize="15" HorizontalAlignment="Center" />
            </StackPanel>
        </Button>

        <StackPanel Spacing="6" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Ellipse Width="10" Height="10" VerticalAlignment="Center" Fill="{Binding StatusColor}" />
                <TextBlock Text="{Binding StatusText}" FontSize="16" FontWeight="SemiBold"
                           Foreground="{Binding StatusColor}" />
            </StackPanel>
            <TextBlock Text="{Binding ErrorText}" Classes="subtitle" MaxWidth="420" TextAlignment="Center"
                       HorizontalAlignment="Center"
                       IsVisible="{Binding ErrorText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>

        <Border Classes="card" IsVisible="{Binding IsConnected}" MinWidth="360">
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="14" ColumnSpacing="24">

                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="IP через туннель" Classes="label" />
                    <TextBlock Text="{Binding PublicIp}" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1">
                    <TextBlock Text="Пинг" Classes="label" />
                    <TextBlock Text="{Binding Rtt}" Classes="value" />
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0">
                    <TextBlock Text="Отправлено ↑" Classes="label" />
                    <TextBlock Text="{Binding TrafficUp}" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1">
                    <TextBlock Text="Принято ↓" Classes="label" />
                    <TextBlock Text="{Binding TrafficDown}" Classes="value" />
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="Время сессии" Classes="label" />
                    <TextBlock Text="{Binding Uptime}" Classes="value" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Text="Несущих" Classes="label" />
                    <TextBlock Text="{Binding Carriers}" Classes="value" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
