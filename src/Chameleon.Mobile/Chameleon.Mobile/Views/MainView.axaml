<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Chameleon.Mobile.ViewModels"
             xmlns:views="using:Chameleon.Mobile.Views"
             x:Class="Chameleon.Mobile.Views.MainView"
             x:DataType="vm:MainViewModel"
             Background="#0D1117">
    <Grid RowDefinitions="*,Auto">

        <ContentControl Grid.Row="0" Content="{Binding Current}">
            <ContentControl.DataTemplates>
                <DataTemplate DataType="vm:ConnectPageViewModel">
                    <views:ConnectPage />
                </DataTemplate>
                <DataTemplate DataType="vm:ServersPageViewModel">
                    <views:ServersPage />
                </DataTemplate>
                <DataTemplate DataType="vm:RoutingPageViewModel">
                    <views:RoutingPage />
                </DataTemplate>
                <DataTemplate DataType="vm:SettingsPageViewModel">
                    <views:SettingsPage />
                </DataTemplate>
            </ContentControl.DataTemplates>
        </ContentControl>

        <Border Grid.Row="1" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*,*" Height="62">

                <Button Grid.Column="0" Classes="nav" Command="{Binding GoCommand}" CommandParameter="connect"
                        Classes.active="{Binding IsConnect}">
                    <StackPanel>
                        <Path Classes="navicon" Data="M12 3 L12 11 M18.4 6.6 a 9 9 0 1 1 -12.8 0" />
                        <TextBlock Text="Подключение" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Classes="nav" Command="{Binding GoCommand}" CommandParameter="servers"
                        Classes.active="{Binding IsServers}">
                    <StackPanel>
                        <Path Classes="navicon"
                              Data="M4 5 h16 v5 h-16 z M4 14 h16 v5 h-16 z M7 7.5 h0.01 M7 16.5 h0.01" />
                        <TextBlock Text="Серверы" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Classes="nav" Command="{Binding GoCommand}" CommandParameter="routing"
                        Classes.active="{Binding IsRouting}">
                    <StackPanel>
                        <Path Classes="navicon" Data="M7 4 V14 M7 14 a4 4 0 0 0 4 4 h6 M14 15 l3 3 l-3 3" />
                        <TextBlock Text="Маршруты" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="3" Classes="nav" Command="{Binding GoCommand}" CommandParameter="settings"
                        Classes.active="{Binding IsSettings}">
                    <StackPanel>
                        <Path Classes="navicon"
                              Data="M12 8 a4 4 0 1 0 0.01 0 M12 2 v3 M12 19 v3 M2 12 h3 M19 12 h3 M5 5 l2 2 M17 17 l2 2 M19 5 l-2 2 M7 17 l-2 2" />
                        <TextBlock Text="Настройки" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>

    <UserControl.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav StackPanel">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Spacing" Value="3" />
        </Style>
        <Style Selector="Button.nav TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.nav Path.navicon">
            <Setter Property="Stroke" Value="#8B949E" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- активная вкладка - зелёным -->
        <Style Selector="Button.nav.active TextBlock">
            <Setter Property="Foreground" Value="#3FB950" />
        </Style>
        <Style Selector="Button.nav.active Path.navicon">
            <Setter Property="Stroke" Value="#3FB950" />
        </Style>
    </UserControl.Styles>
</UserControl>